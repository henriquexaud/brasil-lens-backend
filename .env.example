# ---------------------------------------------------------------------------
# Brasil Lens — configuração opcional.
#
# Nada aqui é obrigatório: o docker-compose.yml tem defaults para tudo, e a
# aplicação sobe sem .env. Copie para .env só para mudar algum valor:
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Frontend -------------------------------------------------------------
# De onde o serviço `web` é construído. O padrão é o repositório público do
# frontend no GitHub — não precisa clonar nada. Para usar uma cópia local
# (ex.: desenvolvendo os dois juntos), aponte para a pasta:
# FRONTEND_CONTEXT=../brasil-lens-frontend

# URL da API vista pelo *navegador*, assada no bundle em tempo de build.
# Mudá-la exige reconstruir (`docker compose up --build`).
VITE_API_BASE_URL=http://localhost:8000/api/v1
WEB_PORT=5173

# --- PostgreSQL / PostGIS -------------------------------------------------
POSTGRES_USER=brasil_lens
POSTGRES_PASSWORD=brasil_lens
POSTGRES_DB=brasil_lens
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
API_PORT=8000
# Origens permitidas para CORS (separadas por vírgula). Precisa conter a URL do
# frontend, senão o navegador recusa POST/PUT/DELETE já no preflight.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache em processo das projeções de leitura (segundos). 0 desliga.
READ_CACHE_TTL_SECONDS=300
# Só projeções com até este número de feições entram no cache: uma coleção
# municipal ocupa ~7 MB em memória e tem baixa taxa de acerto.
READ_CACHE_MAX_FEATURES=200
# Cabeçalho Cache-Control (segundos) das respostas de mapa/geo.
HTTP_CACHE_MAX_AGE=300

# --- Ingestão -------------------------------------------------------------
IBGE_BASE_URL=https://servicodados.ibge.gov.br
IBGE_HTTP_TIMEOUT=120
IBGE_MAX_CONCURRENCY=4
# Tolerâncias de simplificação, em graus (SRID 4326).
GEOMETRY_OVERVIEW_TOLERANCE=0.02
GEOMETRY_DETAIL_TOLERANCE=0.002

# --- Rodar a API fora do Docker ----------------------------------------------
# Só é lida quando a API roda direto no host (uvicorn); no compose ela é
# montada a partir das variáveis POSTGRES_* acima.
DATABASE_URL=postgresql+asyncpg://brasil_lens:brasil_lens@localhost:5432/brasil_lens
